<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themePaper"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingEnd="@dimen/screen_padding_horizontal">

        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_logo_box"
                android:elevation="3dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/home_logo_description"
                    android:src="@drawable/ic_logo_git" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:text="@string/home_title"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/home_subtitle"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/settingsButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_header_action"
                android:clickable="true"
                android:contentDescription="@string/home_settings_description"
                android:elevation="3dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sun" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_height"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="?attr/themeIcon" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="?attr/themeTextPrimary"
                android:textColorHint="?attr/themeTextTertiary"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/filterButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:contentDescription="@string/home_filter_description"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_filter"
                    app:tint="?attr/themeIcon" />
            </FrameLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="3dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            tools:itemCount="4"
            tools:listitem="@layout/item_category_chip" />

        <TextView
            android:id="@+id/feedStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="10sp"
            tools:text="Mostrando 4 de 10 apps" />

        <FrameLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="3dp"
                tools:itemCount="2"
                tools:listitem="@layout/item_app_card" />

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:padding="8dp"
                android:text="@string/empty_repos"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <include
                android:id="@+id/searchLoadingView"
                layout="@layout/view_loading_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@drawable/bg_bottom_navigation"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="3dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/GitAppStoreBottomNavItem"
            android:contentDescription="@string/bottom_home">

            <ImageView
                android:id="@+id/navItemIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/themePrimary" />

            <TextView
                android:id="@+id/navItemLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="@string/bottom_home"
                android:textColor="?attr/themePrimary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navExplore"
            style="@style/GitAppStoreBottomNavItem"
            android:contentDescription="@string/bottom_explore">

            <ImageView
                android:id="@+id/navItemIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_explore"
                app:tint="?attr/themeTextSecondary" />

            <TextView
                android:id="@+id/navItemLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="@string/bottom_explore"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFavorites"
            style="@style/GitAppStoreBottomNavItem"
            android:contentDescription="@string/bottom_favorites">

            <ImageView
                android:id="@+id/navItemIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_favorite"
                app:tint="?attr/themeTextSecondary" />

            <TextView
                android:id="@+id/navItemLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="@string/bottom_favorites"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            style="@style/GitAppStoreBottomNavItem"
            android:contentDescription="@string/bottom_recommended">

            <ImageView
                android:id="@+id/navItemIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star"
                app:tint="?attr/themeTextSecondary" />

            <TextView
                android:id="@+id/navItemLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="@string/bottom_recommended"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

