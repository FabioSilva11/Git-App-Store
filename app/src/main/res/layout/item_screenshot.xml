<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="?attr/themeSurfaceCard"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="1dp"
    app:strokeColor="?attr/themeBorder"
    app:strokeWidth="1dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/screenshotImage"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:background="?attr/themeSurfaceAccent"
        android:contentDescription="@string/screenshots_title"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceGitAppStoreRounded" />
</com.google.android.material.card.MaterialCardView>

